# Server environment — copy to .env and fill in. NEVER commit real secrets.
PORT=4000

# Admin password for /admin panel. Required. Choose a strong value.
ADMIN_PASSWORD=change-me-to-a-strong-password

# Database: leave unset for local zero-config SQLite (./data/nocturne.db).
# Set to a PostgreSQL connection string for persistent production data
# (Render injects this automatically from the render.yaml database).
# DATABASE_URL=postgresql://user:password@host:5432/nocturne

# Seed the demo catalog after first install (SQLite only):
#   npm install && npm run seed
# On Render with PostgreSQL, the server auto-seeds on boot when empty.
